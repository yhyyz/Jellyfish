# Jellyfish Backend - 环境变量示例
# 复制为 .env 后按需修改

# 应用
APP_NAME=Jellyfish API
DEBUG=false

# API
API_V1_PREFIX=/api/v1

# Authentication (leave empty to disable API key verification)
# API_KEY=your-secret-api-key

# 数据库（默认 SQLite 异步）
# DATABASE_URL=sqlite+aiosqlite:///./jellyfish.db
# PostgreSQL 示例:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/jellyfish
# MySQL 示例（使用 aiomysql 驱动）:
# DATABASE_URL=mysql+aiomysql://user:pass@localhost:3306/jellyfish

# Redis / Celery Broker
# 默认情况下，若未单独指定 CELERY_BROKER_URL，系统会自动使用以下 Redis 配置拼接：
# redis://[:password@]host:port/db
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=
# 如需单独覆盖，可直接指定完整 broker URL：
# CELERY_BROKER_URL=redis://localhost:6379/0

# CORS 前端地址（逗号分隔）
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 图片生成（用于演员/角色/道具/场景/服装/镜头帧图片生成任务）
# IMAGE_API_PROVIDER=openai
# IMAGE_API_BASE_URL=https://example.com/v1/images/generations
# IMAGE_API_KEY=your-image-api-key

# 视频生成（用于 /film/generated_video 等接口）
# VIDEO_API_PROVIDER=openai
# VIDEO_API_BASE_URL=https://example.com/v1/videos/generations
# VIDEO_API_KEY=your-video-api-key

# S3 / 对象存储（素材文件）
# 如使用 AWS S3，可按需填写：
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_REGION_NAME=ap-southeast-1
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_BUCKET_NAME=jellyfish-assets
# 可选统一前缀，方便按环境/项目隔离，如 jellyfish/dev
# S3_BASE_PATH=jellyfish/dev
# 若有 CDN/自定义域名，可配置成 https://cdn.example.com
# S3_PUBLIC_BASE_URL=

# SMTP（W26-T1：合规 BLOCKER 告警 email 通道）
# 未配置 SMTP_HOST 时 dispatcher 跳过 email 渠道，仅 Slack 投递。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=alerts@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_USE_TLS=false      # true=直连 TLS（一般端口 465），与 SMTP_START_TLS 互斥
# SMTP_START_TLS=true     # true=明文连接后协商 STARTTLS（一般端口 587）
# SMTP_SENDER=alerts@example.com

# === P5 W32 / v0.7.1 RBAC 与安全 ===
# JELLYFISH_ENV：development / staging / production / prod
# 取值落入 {production, prod, staging} 时启动期 sanity check 会强制
# 拒绝下列默认值，避免生产环境暴露 admin/changeme 账号或重放签名风险。
# JELLYFISH_ENV=development

# SECRET_KEY：JWT 签名密钥，MUST CHANGE before production
# 生产部署必须改成 32+ 字节随机串：openssl rand -hex 32
# SECRET_KEY=change-me-in-production-please-use-a-random-32byte-key

# JWT_FALLBACK_TO_STATIC：v0.7.1 默认 false（关闭旧 api_key 静态 token）
# 临时回滚迁移期可设为 true；P6 起会彻底删除该 fallback 分支。
# JWT_FALLBACK_TO_STATIC=false

# BOOTSTRAP_ADMIN：启动期幂等创建首个 admin 用户（仅当 users 表为空）
# MUST CHANGE before production —— 否则 admin/changeme 在公网即时被入侵
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_EMAIL=admin@jellyfish.local
# BOOTSTRAP_ADMIN_PASSWORD=changeme
