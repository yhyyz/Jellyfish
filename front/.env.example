# .env.example

# 是否使用 Mock 数据（true 时启用 MSW 与本地演示数据）
VITE_USE_MOCK=true

# API 配置示例
# VITE_API_URL=https://api.example.com

# 后端地址（直连后端时使用），例如：
# VITE_BACKEND_URL=http://127.0.0.1:8000

# API BaseURL（默认同源 /api；如需直连后端，可设为 ${VITE_BACKEND_URL}）
#
# v0.7.2 注意（Manual QA Bug E 防呆）：
#   generated client 内每个 method 的 url 已含 /api/v1/... 前缀，
#   若此处填带末尾 /api 的形态，会触发末尾 /api 自动 strip，避免拼成双 /api 404。
#   推荐填后端根 URL（不含 /api 后缀），如：
#     VITE_API_BASE_URL=http://127.0.0.1:8088
#   不推荐：
#     VITE_API_BASE_URL=http://127.0.0.1:8088/api  （末尾 /api 会被自动 strip）
# VITE_API_BASE_URL=/api

# 应用配置示例
# VITE_APP_TITLE=Jellyfish Frontend
