## MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=jellyfish
MYSQL_USER=jellyfish
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306

## Redis / Celery Broker
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
# 如需单独覆盖完整 broker 地址，可设置：
# CELERY_BROKER_URL=redis://redis:6379/0

## Backend
# 可选：如需真实调用大模型，再设置
# OPENAI_API_KEY=

## RustFS (S3 compatible)
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
S3_BUCKET_NAME=jellyfish-assets
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

## Front runtime config (served as /env.js)
# 由于前后端分端口部署，浏览器应访问宿主机的后端地址
BACKEND_URL=http://localhost:8000

## P5 W32 / v0.7.1 RBAC 与安全
# JELLYFISH_ENV：development / staging / production / prod
# 取值落入 {production, prod, staging} 时启动期 sanity check 会强制
# 拒绝下列默认占位值，避免 admin/changeme 在公网即时入侵或重放签名风险。
# JELLYFISH_ENV=development

# SECRET_KEY  # MUST CHANGE before production —— openssl rand -hex 32
# SECRET_KEY=change-me-in-production-please-use-a-random-32byte-key

# JWT_FALLBACK_TO_STATIC：v0.7.1 默认 false（关闭旧 api_key 静态 token）
# JWT_FALLBACK_TO_STATIC=false

# BOOTSTRAP_ADMIN_PASSWORD  # MUST CHANGE before production
# 生产环境保留默认 'changeme' 会让 lifespan 启动 sanity check 直接 raise
# BOOTSTRAP_ADMIN_PASSWORD=changeme
